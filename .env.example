# Copy this file to backend/.env and fill in the values (ask the team lead privately).
# Never commit the real .env. Wrap values that contain # in quotes, e.g. KEY="a#b".

# MongoDB Atlas (shared team database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travel?retryWrites=true&w=majority

# Auth (ACC-04..06, ACC-19) — use a long random string
JWT_SECRET=change-me-to-a-long-random-string
# access-token lifetime; sessions also expire after 30 min without requests (ACC-06)
JWT_EXPIRES_IN=15m
# cookies are Secure (works on http://localhost); set to false only if your client refuses them
COOKIE_SECURE=true

# Seeded administrator (ACC: admins cannot self-register). Created on first start if no admin exists.
ADMIN_EMAIL=admin@travel.local
ADMIN_PASSWORD=Change-Me-Admin1!

# Reference data (GEN-12) is loaded from backend/seed-data on every start; set false to skip
SEED_ON_START=true

# Server
PORT=3000
FRONTEND_URL=http://localhost:3001

# Stripe test mode (PAY-01) — keys start with sk_test_ / whsec_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# FXRatesAPI (ITN-18) — backend only, never exposed to the frontend
FXRATES_API_KEY=
